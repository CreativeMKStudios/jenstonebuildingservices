---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found | Jenstone Building Services"
  description="That page is not on the Jenstone Building Services site. Go back to the homepage or contact the Bedford team."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>That page is not here</h1>
      <p class="lede">The link may be old. The building work is still at the pages below.</p>
      <div class="hero-actions">
        <a class="btn" href="/">Home</a>
        <a class="btn btn-ghost" href="/contact/">Contact</a>
        <a class="btn btn-ghost" href="/services/">Services</a>
      </div>
    </div>
  </section>
</Base>
