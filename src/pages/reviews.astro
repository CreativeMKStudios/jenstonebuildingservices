---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import QuoteBand from "../components/QuoteBand.astro";
import { reviews, photos, site, breadcrumbSchema, graph } from "../data/site";

const crumbs = [
  { name: "Home", path: "/" },
  { name: "Reviews", path: "/reviews/" },
];

const schema = graph(breadcrumbSchema(crumbs), {
  "@type": "WebPage",
  name: "Google reviews",
  url: `${site.url}/reviews/`,
  description: "All 7 Google reviews for Jenstone Building Services in Bedford. Rating 5.0.",
});
---

<Base
  title="Google Reviews | Jenstone Building Services"
  description="All 7 Google reviews for Jenstone Building Services in Bedford. The rating is 5.0. Read them here, or open our Google profile."
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>Reviews</span>
      </nav>
      <h1>5.0 from 7 Google reviews</h1>
      <p class="lede">
        These are the reviews on our Google profile, in the words people left. Names were not published on the copies we hold, apart from the firm that signed one of them. The 2014 note is about tool supply, from when the company traded that way as well.
      </p>
      <p>
        <a class="btn" href={site.map}>Open the Google profile</a>
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap reviews">
      {
        reviews.map((review) => (
          <article class="review">
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <blockquote>
              <p>{review.quote}</p>
            </blockquote>
            <footer>
              {review.by}
              <br />
              <time datetime={review.date}>{review.dateLabel}</time>
            </footer>
          </article>
        ))
      }
    </div>
    <div class="wrap" style="margin-top: 28px;">
      <figure class="card" style="max-width: 720px;">
        <Image src={photos.workshop.src} alt={photos.workshop.alt} widths={[640, 1200]} sizes="(max-width: 760px) 100vw, 720px" />
        <figcaption class="card-body">
          The profile also carries our logo and this workshop photograph. Both are on this site.
        </figcaption>
      </figure>
    </div>
  </section>
  <QuoteBand />
</Base>
