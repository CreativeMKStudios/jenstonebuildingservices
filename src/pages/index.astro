---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import QuoteBand from "../components/QuoteBand.astro";
import {
  site,
  services,
  projects,
  reviews,
  areas,
  photos,
  faqs,
  localBusinessSchema,
  breadcrumbSchema,
  graph,
} from "../data/site";

const schema = graph(
  localBusinessSchema(),
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    publisher: { "@id": `${site.url}/#business` },
    inLanguage: "en-GB",
  },
  {
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
  breadcrumbSchema([{ name: "Home", path: "/" }]),
);

const homeReviews = reviews.slice(0, 3);
---

<Base
  title="Jenstone Building Services | Builders in Bedford"
  description="Family builders in Bedford since 2012. Heritage repairs, extensions, brickwork and renovations across Bedfordshire and Buckinghamshire. FMB member. Call 01234 826776."
  schema={schema}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="kicker">Bedford builders since {site.founded}</p>
      <h1>Built to last. Finished with care.</h1>
      <p class="lede">
        Jenstone is a family firm on Goldington Road. We repair old houses, add the rooms you are short of, and leave the site as tidy as the brickwork.
      </p>
      <div class="hero-actions">
        <a class="btn" href="/contact/">Get a free quote</a>
        <a class="btn btn-ghost" href="/projects/">See the work</a>
      </div>
    </div>
    <div class="hero-media">
      <Image
        src={photos.extension.src}
        alt={photos.extension.alt}
        widths={[640, 960, 1400]}
        sizes="(max-width: 980px) 100vw, 48vw"
        loading="eager"
        fetchpriority="high"
      />
      <p class="hero-caption">Brick extension, Bedfordshire</p>
    </div>
  </section>

  <section class="proof" aria-label="Company facts">
    <div>
      <strong>2012</strong>
      <span>Family firm, still in Bedford</span>
    </div>
    <div>
      <strong>5.0</strong>
      <span>From 7 Google reviews</span>
    </div>
    <div>
      <strong>FMB</strong>
      <span>Listed master builder</span>
    </div>
    <div>
      <strong>Grade II</strong>
      <span>Lime, brick and clay tiles</span>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Services</p>
          <h2>Work we do every week</h2>
          <p>Five trades, one team. Ben and the crew run the job from the first visit to the last clean-up.</p>
        </div>
        <a class="text-link" href="/services/">All services</a>
      </div>
      <div class="cards">
        {
          services.map((item) => (
            <article class="card">
              <a class="stretch" href={`/services/${item.slug}/`}>
                <Image src={item.image.src} alt={item.image.alt} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 33vw" />
                <div class="card-body">
                  <h3>{item.title}</h3>
                  <p>{item.short}</p>
                  <span class="more">More about this</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mission">
    <Image
      src={photos.barn.src}
      alt={photos.barn.alt}
      widths={[640, 960, 1200]}
      sizes="(max-width: 980px) 100vw, 46vw"
    />
    <div class="mission-copy">
      <p class="kicker">How we work</p>
      <h2>A clean site is part of the job</h2>
      <p>
        A floor layer who works with us said it plainly. When they arrive, the site is ready and clean. That is not an accident. We plan the order of work, keep you posted, and do not leave the mess for the next trade.
      </p>
      <p>
        The firm is family run. Clients deal with Ben. The company behind the name is Jenstone Industrial Ltd, number {site.companyNumber}, at the same Goldington Road address.
      </p>
      <p>
        <a class="btn btn-dark" href="/about/">About us</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Projects</p>
          <h2>Recent building work</h2>
          <p>Extensions, garden walls, listed roofs, lime floors and full refits. These are our photographs.</p>
        </div>
        <a class="text-link" href="/projects/">All projects</a>
      </div>
      <div class="cards">
        {
          projects.slice(0, 3).map((item) => (
            <article class="card">
              <a class="stretch" href={`/projects/${item.slug}/`}>
                <Image src={item.image.src} alt={item.image.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" />
                <div class="card-body">
                  <p class="kicker">{item.service}</p>
                  <h3>{item.title}</h3>
                  <p>{item.summary}</p>
                  <span class="more">View project</span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Google reviews</p>
          <h2>5.0 from 7 reviews</h2>
          <p>Every review on our Google profile is shown on the reviews page. Here are three of them.</p>
        </div>
        <a class="text-link" href="/reviews/">Read all 7</a>
      </div>
      <div class="reviews">
        {
          homeReviews.map((review) => (
            <article class="review">
              <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
              <blockquote>
                <p>{review.quote}</p>
              </blockquote>
              <footer>
                {review.by}
                <br />
                {review.dateLabel}
              </footer>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap areas">
      <div>
        <p class="kicker">Areas</p>
        <h2>Bedford, the county, and over the border</h2>
        <p class="intro">
          The yard is in Bedford. The vans cover Bedfordshire and Buckinghamshire, including Milton Keynes and the villages around the town.
        </p>
        <div class="towns">
          {
            areas.map((area) => (
              <a href={`/areas/${area.slug}/`}>{area.title.replace("Builders in ", "")}</a>
            ))
          }
          <span>Kempston</span>
          <span>Ampthill</span>
          <span>Flitwick</span>
          <span>Wilstead</span>
          <span>Milton Keynes</span>
          <span>Olney</span>
        </div>
      </div>
      <div class="card">
        <Image src={photos.van.src} alt={photos.van.alt} widths={[640, 900]} sizes="(max-width: 980px) 100vw, 40vw" />
        <div class="card-body">
          <h3>Based at 9 Goldington Road</h3>
          <p>Bedford, MK40 3JY. Call {site.phoneDisplay} or the mobile on {site.mobileDisplay}.</p>
          <a class="more" href="/areas/">Areas we cover</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section cream">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">Questions</p>
          <h2>Before you call</h2>
        </div>
      </div>
      <div class="faq">
        {
          faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <QuoteBand />
</Base>
