---
import { site } from "../data/site";
---

<section class="band">
  <div class="wrap band-inner">
    <div>
      <p class="kicker">Free quote</p>
      <h2>Tell us the address and the job.</h2>
      <p class="intro">Call, email, or send a note. We will say if we are the right team and when we can visit.</p>
    </div>
    <div class="hero-actions">
      <a class="btn" href={`tel:${site.phoneTel}`}>Call {site.phoneDisplay}</a>
      <a class="btn btn-ghost" href="/contact/">Contact form</a>
    </div>
  </div>
</section>
